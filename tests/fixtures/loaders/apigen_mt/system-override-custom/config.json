{
  "dataset_config": {
    "drop_consecutive_assistant": false,
    "drop_error_recovery_loops": false,
    "drop_incomplete_termination": true,
    "drop_repeated_tool_call_streaks": false,
    "drop_undefined_function_calls": true,
    "strip_think_tool": false
  },
  "extra_kwargs": {
    "batch_size": 256,
    "curation_config": {
      "audit": true,
      "max_level": "level_2",
      "temporary_directory": null
    }
  },
  "filter_config": {
    "align_results": true,
    "require_balanced_cardinality": true,
    "require_defined_functions": true,
    "require_parseable_arguments": true,
    "require_valid_arguments": true,
    "strip_thinking": true,
    "system_message_override": "Use the available tools carefully."
  }
}
